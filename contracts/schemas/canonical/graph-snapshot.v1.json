{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:canonical:graph-snapshot:v1",
  "title": "Graph snapshot",
  "description": "Immutable named pointer to a revision with a deterministic graph hash (ADR-0008 §4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "org_id",
    "id",
    "revision",
    "label",
    "status",
    "graph_hash"
  ],
  "properties": {
    "org_id": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/uuid7"
    },
    "id": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/uuid7"
    },
    "revision": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/revision"
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "published"
      ]
    },
    "graph_hash": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/sha256"
    }
  }
}
