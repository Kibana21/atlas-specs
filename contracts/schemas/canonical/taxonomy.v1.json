{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:canonical:taxonomy:v1",
  "title": "Atlas taxonomy artifact",
  "description": "Versioned taxonomy and provider registries (ADR-0017, ADR-0019, ADR-0003, ADR-0008 §10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "taxonomy_version",
    "status",
    "source",
    "versioning",
    "enumerations",
    "common_attributes",
    "providers",
    "categories",
    "entity_types",
    "relationship_types",
    "provider_scope_rules",
    "native_type_mappings",
    "identity_namespaces",
    "actor_namespaces",
    "retyping"
  ],
  "properties": {
    "$schema": {
      "const": "urn:atlas:schema:canonical:taxonomy:v1"
    },
    "taxonomy_version": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/taxonomy_version"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "synthetic_test_only"
      ]
    },
    "source": {
      "type": "string"
    },
    "versioning": {
      "type": "object"
    },
    "enumerations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "common_attributes": {
      "type": "object"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "display_name",
          "provider_kind",
          "requires_platform"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          },
          "requires_platform": {
            "type": "boolean"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "kind"
        ]
      }
    },
    "entity_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type_key",
          "kind",
          "category",
          "provider",
          "environment_scope",
          "required_attributes",
          "attribute_enums",
          "identity_namespaces",
          "containment_parents",
          "self_nesting"
        ],
        "properties": {
          "type_key": {
            "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/type_key"
          },
          "kind": {
            "type": "string",
            "enum": [
              "logical",
              "physical"
            ]
          },
          "category": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment_scope": {
            "type": "string",
            "enum": [
              "none",
              "required",
              "optional"
            ]
          },
          "required_attributes": {
            "type": "array",
            "items": {
              "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/attribute_name"
            }
          },
          "attribute_enums": {
            "type": "object"
          },
          "identity_namespaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "containment_parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "self_nesting": {
            "type": "boolean"
          },
          "native_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "synthetic_test_only": {
            "type": "boolean"
          }
        }
      }
    },
    "relationship_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rel_type",
          "status",
          "description",
          "cardinality",
          "pairs",
          "required_attributes",
          "optional_attributes",
          "attribute_enums",
          "discriminator",
          "allowed_evidence_kinds",
          "cross_environment_allowed",
          "logical_only"
        ],
        "properties": {
          "rel_type": {
            "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/rel_type"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "reserved"
            ]
          },
          "description": {
            "type": "string"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "many_to_many",
              "one_parent"
            ]
          },
          "pairs": {
            "type": "array"
          },
          "required_attributes": {
            "type": "array"
          },
          "optional_attributes": {
            "type": "array"
          },
          "attribute_enums": {
            "type": "object"
          },
          "discriminator": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowed_evidence_kinds": {
            "type": "array",
            "items": {
              "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/evidence_kind"
            }
          },
          "cross_environment_allowed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "logical_only": {
            "type": "boolean"
          }
        }
      }
    },
    "provider_scope_rules": {
      "type": "object"
    },
    "native_type_mappings": {
      "type": "object"
    },
    "identity_namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "namespace",
          "provider",
          "status",
          "normalization_rule",
          "case_rule",
          "format",
          "uniqueness_scope"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "implemented",
              "validation_only",
              "planned",
              "reserved"
            ]
          }
        }
      }
    },
    "actor_namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "namespace",
          "actor_kind",
          "key_format",
          "pattern"
        ],
        "properties": {
          "actor_kind": {
            "type": "string",
            "enum": [
              "human",
              "service",
              "system"
            ]
          }
        }
      }
    },
    "retyping": {
      "type": "object"
    },
    "extends": {
      "type": "string"
    },
    "synthetic_note": {
      "type": "string"
    }
  }
}
