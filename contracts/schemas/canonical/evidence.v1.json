{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:canonical:evidence:v1",
  "title": "Evidence",
  "description": "Append-only record of how a source knows something (ADR-0018). Never a secret; never runtime traffic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "org_id",
    "id",
    "kind",
    "source_ref",
    "artifact_ref",
    "artifact_hash",
    "method",
    "confidence",
    "observed_at",
    "valid_from",
    "valid_to",
    "change_revision"
  ],
  "properties": {
    "org_id": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/uuid7"
    },
    "id": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/uuid7"
    },
    "kind": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/evidence_kind"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "artifact_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "artifact_hash": {
      "anyOf": [
        {
          "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "observed_at": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/timestamp"
    },
    "valid_from": {
      "anyOf": [
        {
          "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "change_revision": {
      "$ref": "urn:atlas:schema:canonical:common:v1#/$defs/revision"
    }
  }
}
